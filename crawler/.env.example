# ---------------------------------------------------------------------------
# Pixel Patrol crawler — Cloud Run Job environment contract
#
# auth is Application Default Credentials, never a key file:
#   local:      gcloud auth application-default login
#   Cloud Run:  the job's service account
# ---------------------------------------------------------------------------

# --- required ---

# stable identifier for the site being swept; the Firestore document id under sites/
SITE_ID=example-com

# entry URL for the crawl (http/https only, SSRF validated before any request)
SITE_URL=https://example.com

# identifier for this sweep; the Firestore document id under sites/{SITE_ID}/fingerprints/
SWEEP_ID=2026-08-21T20-00-00Z

# GCP project that owns Firestore and the Pub/Sub topic
GOOGLE_CLOUD_PROJECT=pixel-patrol-mp

# --- optional ---

# how many pages to visit, breadth-first from SITE_URL (default 5)
PAGES_TO_SCAN=5

# Pub/Sub topic that receives the one sweep-done message (default sweep-done)
SWEEP_DONE_TOPIC=sweep-done

# pino level: trace | debug | info | warn | error | fatal (default info)
LOG_LEVEL=info
