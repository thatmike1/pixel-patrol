# GCP project holding Firestore, Pub/Sub, the crawler job and the Vertex quota
GOOGLE_CLOUD_PROJECT=pixel-patrol-mp

# Vertex location for the model. Gemini 3.5 Flash is only served on `global`;
# everything else in this project lives in europe-west1.
GOOGLE_CLOUD_LOCATION=global

# routes the ADK through Vertex (ADC) instead of a public API key
GOOGLE_GENAI_USE_ENTERPRISE=true

MODEL=gemini-3.5-flash

# region of the Cloud Run job and of this service
REGION=europe-west1
CRAWLER_JOB=patrol-crawler
SITE_SWEEP_TOPIC=site-sweep

# the stability window: N sweeps of history the drift classification reasons
# over, and M consecutive absences before a baseline entry counts as removed
STABILITY_WINDOW=5
GONE_AFTER=3

# shared secret for the operator endpoints under /sites
ADMIN_KEY=change-me

# this service's public base URL, the expected OIDC audience of push tokens.
# only known after the first deploy; infra/deploy-agent.sh sets it.
SELF_URL=https://patrol-agent-xxxxxxxx.europe-west1.run.app

PORT=8080
LOG_LEVEL=info
